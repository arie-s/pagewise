{
  "name": "pdf-studio-pro",
  "version": "1.0.0",
  "description": "Full-featured PDF editor with visual editing capabilities",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "cli": "electron . --cli",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "author": "PDF Studio",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "pdfjs-dist": "^4.0.379"
  },
  "build": {
    "appId": "com.pdfstudiopro.app",
    "productName": "PDF Studio Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "linux": {
      "category": "Office",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
