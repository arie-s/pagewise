{
  "name": "pagewise",
  "productName": "Pagewise",
  "version": "1.3.0",
  "description": "Private PDF editor that reads your documents with local AI.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "cli": "electron . cli",
    "test": "node --test --test-isolation=none tests/*.test.cjs",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "author": {
    "name": "arie-s",
    "email": "44439774+arie-s@users.noreply.github.com"
  },
  "homepage": "https://github.com/arie-s/pagewise",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "pdfjs-dist": "^4.0.379",
    "tesseract.js": "^7.0.0"
  },
  "build": {
    "appId": "com.pagewise.app",
    "productName": "Pagewise",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "!node_modules/pdfjs-dist/legacy/**",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/@napi-rs/**",
      "!node_modules/@cantoo/pdf-lib/es/**",
      "!node_modules/@cantoo/pdf-lib/src/**",
      "!node_modules/@cantoo/pdf-lib/dist/pdf-lib*",
      "!node_modules/**/*.map",
      "!node_modules/**/*.d.ts"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-"
    },
    "linux": {
      "category": "Office",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
